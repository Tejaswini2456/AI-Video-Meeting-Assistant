# ── AI Video Assistant Environment Variables ──

# Required: Mistral AI API Key for LLM summarization, extraction & RAG chat
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Sarvam AI API Key for STT translation (Telugu, Hindi, Tamil, Kannada, etc.)
# Get your key at: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional Configurations
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras:v2.5
